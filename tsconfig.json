{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@lib/*": [
        "./lib/*"
      ],
      "@actions/*": [
        "./actions/*"
      ],
      "@components/*": [
        "./components/*"
      ],
      "@consts/*": [
        "./consts/*"
      ],
      "@contexts/*": [
        "./app/contexts/*"
      ],
      "@icons/*": [
        "./icons/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "/dist/types/**/*.ts",
    "/dist/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
